# ETLProcess — required environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and must
# never be committed. Every key below is REQUIRED: the code fails closed with an
# InvalidOperationException naming the missing key rather than falling back to a
# default, because a silent default is how a credential ends up in source.
#
# These values were previously hardcoded. They are not any more. See
# docs/SECRETS-REMEDIATION.md for what was removed and what still needs doing.

# --- SMTP -------------------------------------------------------------------
# Transactional mail service used to send processing notifications.
ETLP_SMTP_HOST=smtp.example.com
ETLP_SMTP_PORT=587
ETLP_SMTP_USER=
ETLP_SMTP_PASSWORD=

# Sender/From address on outbound mail. Internal (processor-side) identity.
ETLP_SMTP_FROM=Sample@ETLP.sample.com

# --- Addresses --------------------------------------------------------------
# Internal address — processor-side support/ops mailbox.
ETLP_SUPPORT_EMAIL=Sample@ETLP.sample.com

# External address — the client receiving statements/notifications.
ETLP_CLIENT_EMAIL=Sample@GPHealth.sample.com

# --- Database ---------------------------------------------------------------
# Full ADO.NET connection string for the statement-processing database.
# Use integrated security where possible; avoid embedding a password at all.
ETLP_SQL_CONNECTION=Data Source=SERVER\INSTANCE;Initial Catalog=DATABASE;Integrated Security=True;
